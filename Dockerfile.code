# FAST code-only rebuild: layer the current code onto an image that already
# contains the data and the built DuckDB (see DEPLOY.md "code-only redeploy").
# The data image is produced by the full Dockerfile; bump DATA_IMAGE only when
# the data or the pipeline changes.

# Passed by cloudbuild.code.yaml (_DATA_IMAGE); the placeholder only documents the shape.
ARG DATA_IMAGE=us-central1-docker.pkg.dev/PROJECT_ID/cloud-run-source-deploy/pisa-explorer:v3
FROM ${DATA_IMAGE}

WORKDIR /app

# The image tag, stamped on every answer's provenance ("build v21") so a
# cited number can be traced to the code that produced it.
ARG BUILD_TAG=dev
ENV PISA_BUILD=${BUILD_TAG}

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY pipeline/ pipeline/
COPY explorer/ explorer/
# Per-economy coverage of questionnaire variables (pipeline/build_coverage.py):
# small and rebuilt with the code, so it rides along here rather than waiting
# for the next data image. .gcloudignore.code re-includes exactly this file.
COPY data/catalog/coverage.parquet data/catalog/coverage.parquet
# Viet Nam's separately released 2018 plausible values (pipeline/load_vnm_2018.py);
# build_db.py joins them into the stu_qqq_2018 view when the file is present.
COPY data/parquet/pisa2018/vnm_pv.parquet data/parquet/pisa2018/vnm_pv.parquet
# Moscow City (QMC), separate 2018 files (pipeline/load_qmc_2018.py), appended to the 2018 views.
COPY data/parquet/pisa2018/qmc_stu_qqq.parquet data/parquet/pisa2018/qmc_stu_qqq.parquet
COPY data/parquet/pisa2018/qmc_sch_qqq.parquet data/parquet/pisa2018/qmc_sch_qqq.parquet

# Re-register views in case pipeline/build_db.py changed (data itself is
# untouched; this takes ~1 s).
RUN python pipeline/build_db.py

ENV BIND_HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
CMD ["python", "-m", "explorer.app"]
